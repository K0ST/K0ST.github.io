---
permalink: /feed.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom">
<title>{{ site.name }}</title><subtitle>{{ site.description }}</subtitle><link href="{{ site.url }}/feed.xml" rel="self"/><link href="{{ site.url }}/"/><id>{{ site.url }}/</id><updated>{% if collections.articles.length %}{{ collections.articles[0].date | isoDate }}{% else %}2026-10-28T00:00:00.000Z{% endif %}</updated><author><name>{{ site.author }}</name></author>
{% for post in collections.articles %}<entry><title>{{ post.data.title }}</title><link href="{{ site.url }}{{ post.url }}"/><id>{{ site.url }}{{ post.url }}</id><updated>{{ post.date | isoDate }}</updated><summary>{{ post.data.description }}</summary></entry>{% endfor %}
</feed>
