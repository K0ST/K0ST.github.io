---
layout: layouts/base.njk
section: posts
isPost: true
---
<article class="reading-layout">
  <a class="back-link" href="/posts/">← 所有文章</a>
  <header class="post-header"><div class="post-meta"><time datetime="{{ page.date | isoDate }}">{{ page.date | dateLabel }}</time><span> / </span><span>{{ category }}</span></div><h1>{{ title }}</h1><p>{{ description }}</p></header>
  <div class="prose">{{ content | safe }}</div>
  <div class="post-end"><span class="brand-icon" aria-hidden="true">K<span>_</span></span><p>感谢阅读。<br><span>下一篇记录，再见。</span></p><a href="/posts/">返回文章列表 →</a></div>
</article>
